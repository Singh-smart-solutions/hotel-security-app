# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real keys.

# Supabase project URL (Project Settings -> API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Supabase anon/public key. This is embedded in the browser bundle, so it is
# NOT a secret on its own — its safety depends entirely on Row Level Security.
# See SECURITY.md before relying on it.
VITE_SUPABASE_ANON_KEY=your-anon-key

# NOTE: OCR runs in the `scan-id` edge function, which uses OCR.space.
# Its API key is a BACKEND-ONLY secret — do not put it here. Set it on the
# edge function instead:
#   npx supabase secrets set OCR_SPACE_API_KEY=your-key
#
# Restrict which origin may call the OCR endpoint from a browser
# (comma-separated list; defaults to the production domain):
#   npx supabase secrets set ALLOWED_ORIGINS=https://hotel-security-app.vercel.app
#
# Deploy the function WITHOUT --no-verify-jwt so only signed-in callers can
# invoke it (this closes the open-proxy / quota-abuse risk):
#   npx supabase functions deploy scan-id
