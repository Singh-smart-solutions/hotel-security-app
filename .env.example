# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real keys.

# Supabase project URL (Project Settings -> API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Supabase anon/public key. This is embedded in the browser bundle, so it is
# NOT a secret on its own — its safety depends entirely on Row Level Security.
# See SECURITY.md before relying on it.
VITE_SUPABASE_ANON_KEY=your-anon-key

# NOTE: The Google Cloud Vision key is a BACKEND-ONLY secret. Do not put it here.
# Set it on the edge function instead:
#   npx supabase secrets set GOOGLE_CLOUD_VISION_API_KEY=your-key
